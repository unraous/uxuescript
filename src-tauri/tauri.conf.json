{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uXueScript",
  "identifier": "top.unraous.uxs",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../dist/scripts"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "unraous",
    "licenseFile": "../LICENSE",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "fragmentPaths": [
          "./windows/fragments/updater-marker.wxs"
        ],
        "componentRefs": [
          "UpdaterInstallMarker"
        ],
        "upgradeCode": "e17c0865-5de2-58e1-b409-c39958ff8116",
        "language": {
          "zh-CN": {
            "localePath": "./windows/installer/zh-CN.wxl"
          }
        },
        "bannerPath": "./windows/installer/banner.bmp",
        "dialogImagePath": "./windows/installer/dialog.bmp"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "version": "2.5.3",
  "plugins": {
    "uxuescript": {
      "homeUrl": "https://i.mooc.chaoxing.com/",
      "msi": {
        "componentId": "UpdaterInstallMarker",
        "valueName": "UpdaterInstall",
        "value": 1,
        "keys": {
          "top.unraous.uxs": "Software\\unraous\\uxuescript",
          "top.unraous.uxs.mock": "Software\\unraous\\uxuescript.mock"
        }
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/unraous/uxuescript/releases/latest/download/latest.json",
        "https://gitee.com/unraous/uxuescript/raw/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NDQyODU4QTM3NzU2N0EKUldSNlZuZWpXQ2hFWmlwbkVtWUVPdlhsaGxJc1VBY1V3cUswa2hRQktYYUcrRFBidE9GaGt4eXUK"
    }
  }
}
