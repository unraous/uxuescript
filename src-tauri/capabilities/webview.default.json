{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "webview.default",
  "description": "Default capability for the application webviews",
  "webviews": [
    "main",
    "mask"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    "commands-main",
    "log:default"
  ]
}