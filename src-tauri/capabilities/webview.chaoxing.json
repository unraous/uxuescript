{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "webview.chaoxing",
  "description": "Limited capability for the Chaoxing webview",
  "webviews": [
    "chaoxing"
  ],
  "remote": {
    "urls": [
      "https://*.chaoxing.com/**"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "commands-chaoxing",
    "log:default"
  ]
}